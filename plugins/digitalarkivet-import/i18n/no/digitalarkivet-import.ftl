# Digitalarkivet-import: norske etiketter (ADR 0017 §5, ADR 0012 §5, ADR 0003). Programtillegget
# sender disse melding-id-ene som felt- og handlingsetiketter; veiviseren slår dem opp i denne
# katalogen. Selve postinnholdet (navn, datoer, steder) sendes ordrett og oversettes aldri.

# Feltetiketter (de transkriberte folketellings-/kirkebokfeltene som vises for gjennomgang).
field-name = Navn
field-birth = Født
field-birthplace = Fødested
field-residence = Bosted
field-role = Familiestilling
field-marital-status = Sivilstand
field-occupation = Yrke

# Handlingsetiketter (knappene under bekreftelsesskjemaet).
action-import = Importer og neste
action-skip = Hopp over

# Digitalarkivet assisted-import plugin labels (ADR 0017 §5, ADR 0012 §5, ADR 0003). The plugin sends
# these message ids as the confirm-record field/action labels; the first-party wizard resolves them
# against this catalogue. Record content (names, dates, places) is sent verbatim and never resolved.

# Field labels (the transcribed census/church-book fields shown for review).
field-name = Name
field-birth = Born
field-birthplace = Birth place
field-residence = Residence
field-role = Family position
field-marital-status = Marital status
field-occupation = Occupation

# Action labels (the buttons under the confirm form).
action-import = Import & next
action-skip = Skip

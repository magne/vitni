// The versioned host-API contract every plugin compiles against (ADR 0007 §2, ADR 0011 §1).
//
// Capabilities are separate interfaces (`log`, `query`, `commands`, `progress`, `import-source`,
// `export-sink`); each plugin role is a world that imports only the capabilities it needs and
// exports one entry point. Records mirror the `genealogy-app` DTOs (ADR 0006) — no storage or
// framework type crosses this boundary.
//
// Version 0.3.0 generalizes the two GEDCOM worlds into format-neutral `bulk-import` / `bulk-export`
// worlds and adds the `progress`, `import-source`, and `export-sink` capabilities that back them
// (ADR 0013). The streaming source/sink let a plugin read/write an arbitrarily large document a
// chunk at a time while the host owns the actual file path; `progress` lets a bulk operation report
// how far it has advanced. The two GEDCOM-specific worlds are removed (they were spike-only and have
// no external plugins), so this is the first world removal — a deliberate, documented break.
//
// Version 0.4.0 adds the `external-id` record and makes `commands.create-person` /
// `commands.create-family` resolve-or-create against it: an incoming record carrying an external id
// is matched to its existing aggregate (data-model §11) instead of creating a duplicate, so a
// re-import of an unchanged document produces no changes. `add-partner` / `add-child` are now
// idempotent (an already-present member is a no-op). A breaking signature change to `commands`.
//
// Version 0.5.0 grows `commands` toward GEDCOM 7 breadth: `assert-sex` plus the create/link verbs
// for Event, Place, Source, Citation, Media, and Note, so a richer import maps every record to its
// aggregate rather than dropping all but Person/Family. Additive to the interface.
//
// Version 0.6.0 fills the GEDCOM 7 round-trip (data-model F′): `create-person` now carries a
// structured `person-name` (GEDCOM `NAME` sub-records — given/surname/prefix/suffix/nickname/type)
// instead of bare given+surname, and `set-event-date` carries a full `genealogical-date` (calendar,
// quality, modifier — replacing year/month/day). New verbs `assert-fact` (INDI attributes →
// `FactAsserted`), `assert-association` (`ASSO`/`ROLE` → person↔person), and `set-event-address`
// (`ADDR` → an Event address). `event-type` and `participant-role` grow to the full first-class
// enum sets. `person-dto` gains the structured name parts an exporter reconstructs a `NAME` from.
// A breaking signature change to `commands` and `query`.
package genealogy:host-api@0.6.0;

interface types {
    // The kind of a name (data-model §7 / GEDCOM `NAME.TYPE`), mirroring `genealogy_core::name::NameType`.
    variant name-type {
        birth-name,
        married-name,
        maiden,
        immigrant,
        professional,
        also-known-as,
        religious-name,
        custom(string),
    }

    // The structured parts of a person's name (GEDCOM 7 `NAME` sub-records — data-model §7), mirroring
    // the parts of `genealogy_core::name::PersonName` an importer parses and an exporter reconstructs.
    record person-name {
        name-type: name-type,
        given: option<string>,
        surname-prefix: option<string>, // GEDCOM SPFX
        surname: option<string>,        // GEDCOM SURN
        nickname: option<string>,       // GEDCOM NICK
        prefix: option<string>,         // GEDCOM NPFX (-> title)
        suffix: option<string>,         // GEDCOM NSFX
    }

    // A person as a frontend reads it — mirrors `genealogy_app::PersonSummary` plus the structured
    // name parts an exporter needs to reconstruct a GEDCOM `NAME`.
    record person-dto {
        human-id: string,
        given: option<string>,
        surname: option<string>,
        surname-prefix: option<string>,
        nickname: option<string>,
        name-prefix: option<string>,
        name-suffix: option<string>,
        name-type: option<name-type>,
    }

    // A family as a frontend reads it — mirrors `genealogy_app::FamilySummary`. Partners and
    // children are referenced by their human ids.
    record family-dto {
        human-id: string,
        partners: list<string>,
        children: list<string>,
    }

    // A stable identifier in an external system (data-model §7, §11) — mirrors
    // `genealogy_core::text::ExternalId`. The re-import resolution key: an incoming record carrying
    // an external id is matched to its existing aggregate rather than duplicated. `authority` names
    // the system (e.g. `gedcom-uid`), `value` the id within it.
    record external-id {
        authority: string,
        value: string,
        kind: option<string>,
        url: option<string>,
    }

    // Biological sex as recorded (data-model §10), mirroring `genealogy_core::enums::Sex` for the
    // values an importer produces.
    enum sex {
        male,
        female,
        unknown,
    }

    // The outcome of a resolve-or-create command: the aggregate's human id, and whether it was newly
    // created (false = an existing aggregate was resolved by external id). An importer uses `created`
    // to attach owned records (events, places) only on first import, keeping re-import idempotent.
    record import-result {
        human-id: string,
        created: bool,
    }

    // The kind of an event (data-model §10), mirroring the first-class `genealogy_core::enums::EventType`
    // variants (the `Custom` escape is not produced by the importer).
    enum event-type {
        birth,
        death,
        marriage,
        baptism,
        christening,
        burial,
        cremation,
        census,
        residence,
        immigration,
        emigration,
        adoption,
        confirmation,
        bar-mitzvah,
        bas-mitzvah,
        first-communion,
        graduation,
        naturalization,
        ordination,
        probate,
        retirement,
        will,
        engagement,
        annulment,
        divorce,
        divorce-filed,
        marriage-banns,
        marriage-contract,
        marriage-license,
        marriage-settlement,
    }

    // A participant's role in an event (data-model §10), mirroring the first-class
    // `genealogy_core::enums::ParticipantRole` variants.
    enum participant-role {
        primary,
        witness,
        officiator,
        clergy,
        father,
        mother,
        parent,
        child,
        husband,
        wife,
        spouse,
        godparent,
        friend,
        neighbour,
        multiple,
        bride,
        groom,
    }

    // The kind of a single-person fact (data-model §7, §10 / GEDCOM INDI attributes), mirroring the
    // first-class `genealogy_core::enums::FactType` variants.
    variant fact-type {
        birth,
        death,
        baptism,
        burial,
        occupation,
        residence,
        religion,
        caste,
        physical-description,
        education,
        ethnicity,
        national-id,
        nationality,
        number-of-children,
        number-of-marriages,
        property,
        social-security-number,
        nobility-title,
        custom(string),
    }

    // The kind of a person-to-person association (GEDCOM 7 `ASSO.ROLE` — data-model §7), mirroring
    // `genealogy_core::enums::AssociationRole`.
    variant association-role {
        clergy,
        friend,
        godparent,
        neighbour,
        officiator,
        witness,
        child,
        father,
        mother,
        parent,
        husband,
        wife,
        spouse,
        multiple,
        custom(string),
    }

    // A calendar a date is expressed in (data-model §7.1), mirroring `genealogy_core::date::Calendar`.
    enum date-calendar {
        gregorian,
        julian,
        hebrew,
        french-republican,
        islamic,
        swedish,
    }

    // How reliable a date is (data-model §7.1), mirroring `genealogy_core::date::DateQuality`.
    enum date-quality {
        normal,
        estimated,
        calculated,
    }

    // A single, possibly-partial point on a calendar; `year` may be negative for BCE (data-model §7.1).
    record date-point {
        year: option<s32>,
        month: option<u8>,
        day: option<u8>,
    }

    // Two points bounding a `range` (uncertainty) or `span` (duration).
    record date-range {
        start: date-point,
        end: date-point,
    }

    // A date interpreted from a free-text phrase (GEDCOM `INT`): the structured reading plus the phrase.
    record interpreted-date {
        date: date-point,
        phrase: string,
    }

    // How a date is qualified (data-model §7.1), mirroring `genealogy_core::date::DateModifier` plus the
    // `text-only` free-text fallback (`GenealogicalDateBody::TextOnly`) for an unparseable date.
    variant date-modifier {
        exact(date-point),
        before(date-point),
        after(date-point),
        about(date-point),
        range(date-range),
        span(date-range),
        from-date(date-point),
        to-date(date-point),
        interpreted(interpreted-date),
        text-only(string),
    }

    // A full structured genealogical date (data-model §7.1) — calendar, quality, modifier, optional
    // dual-dating month, and the verbatim source phrase. The host computes the sort key.
    record genealogical-date {
        calendar: date-calendar,
        quality: date-quality,
        modifier: date-modifier,
        new-year-begins: option<u8>,
        original-text: option<string>,
    }

    // A postal address (GEDCOM `ADDR` — data-model §7), mirroring `genealogy_core::address::Address`.
    record address {
        lines: list<string>,
        locality: option<string>,
        region: option<string>,
        postal-code: option<string>,
        country: option<string>,
        phone: option<string>,
        email: option<string>,
        fax: option<string>,
        www: option<string>,
        original-text: option<string>,
    }

    // Why a capability call failed. `denied` is the deny-by-default signal (ADR 0011 §2): the
    // capability was not granted to this instance. `backend` carries an I/O or infrastructure
    // failure message (a missing file, an unreadable stream).
    variant capability-error {
        denied,
        invalid-input(string),
        backend(string),
    }
}

// Structured logging from the guest into host `tracing` (ADR 0007 §6).
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }

    log: func(level: level, message: string);
}

// Read views as frontend-neutral DTOs (ADR 0007 §6 `query`).
interface query {
    use types.{person-dto, family-dto, capability-error};

    list-persons: func() -> result<list<person-dto>, capability-error>;
    list-families: func() -> result<list<family-dto>, capability-error>;
}

// Submit domain commands through `genealogy-app` use-cases (ADR 0007 §6 `commands`). Every change
// is attributed to an `AgentKind::Software` operator (ADR 0007 §7). Returned strings are the
// assigned human ids, which the guest maps back to source-file cross-references.
interface commands {
    use types.{external-id, sex, import-result, event-type, participant-role, person-name, genealogical-date, fact-type, association-role, address, capability-error};

    // Resolve-or-create a person. When `external-id` is given and already resolves to a person, that
    // person is returned (`created = false`) and the name is asserted only if not already present
    // (idempotent, additive re-import); otherwise a new person is created (`created = true`). When
    // `external-id` is absent, a new person is always created.
    create-person: func(name: option<person-name>, external-id: option<external-id>) -> result<import-result, capability-error>;
    // Resolve-or-create a family, by `external-id` as `create-person`.
    create-family: func(external-id: option<external-id>) -> result<import-result, capability-error>;
    // Add a partner; an already-present partner is a no-op (idempotent re-import).
    add-partner: func(family: string, person: string) -> result<_, capability-error>;
    // Add a (birth) child; an already-present child is a no-op (idempotent re-import).
    add-child: func(family: string, child: string) -> result<_, capability-error>;
    // Assert a person's sex.
    assert-sex: func(person: string, sex: sex) -> result<_, capability-error>;
    // Assert a single-person fact (an INDI attribute — occupation, religion, …) with an optional
    // free-text value and date.
    assert-fact: func(person: string, fact: fact-type, value: option<string>, date: option<genealogical-date>) -> result<_, capability-error>;
    // Assert a person-to-person association (GEDCOM `ASSO`) from one person to another, with a role.
    assert-association: func(person: string, other: string, role: association-role) -> result<_, capability-error>;
    // Create a place with `name` (granularity unknown — typed as a custom place). Returns its human
    // id; the caller dedups by name so each distinct place is created once per import.
    create-place: func(name: string) -> result<string, capability-error>;
    // Create an event of `kind`. Returns its human id.
    create-event: func(kind: event-type) -> result<string, capability-error>;
    // Assert an event's date (the full GEDCOM date grammar — calendar, quality, modifier).
    set-event-date: func(event: string, date: genealogical-date) -> result<_, capability-error>;
    // Add a postal address (GEDCOM `ADDR`) to an event.
    set-event-address: func(event: string, address: address) -> result<_, capability-error>;
    // Link an event to a place.
    link-event-place: func(event: string, place: string) -> result<_, capability-error>;
    // Record that a person participated in an event, with a role.
    add-event-participant: func(person: string, event: string, role: participant-role) -> result<_, capability-error>;
    // Create a source with an optional title. Returns its human id; the caller dedups by source so
    // each is created once per import.
    create-source: func(title: option<string>) -> result<string, capability-error>;
    // Create a citation of `source` (a source human id) with an optional page locator. Returns its
    // human id.
    create-citation: func(source: string, page: option<string>) -> result<string, capability-error>;
    // Create a media object with an optional file path/URL. Returns its human id; the caller dedups
    // by file so a shared media object is created once.
    create-media: func(file: option<string>) -> result<string, capability-error>;
    // Create a note with Markdown text. Returns its human id.
    create-note: func(text: string) -> result<string, capability-error>;
}

// Coarse-grained progress reporting for a bulk operation (ADR 0013). The guest reports as it
// advances; the host forwards each update to a frontend-supplied sink (the CLI prints a line, a GUI
// updates a bar). `total` is optional because an importer often cannot know the record count until
// it has read the whole document.
//
// Each report is also a cancellation point: the host's answer tells the guest whether to keep going
// or stop. A guest must honor `cancel` by ending the operation promptly (returning what it has done
// so far); the frontend triggers it (a GUI cancel button, a CLI interrupt).
interface progress {
    use types.{capability-error};

    // The host's answer to a progress report.
    enum control {
        proceed,
        cancel,
    }

    report: func(step: string, processed: u32, total: option<u32>) -> result<control, capability-error>;
}

// A host-opened byte source for a bulk import (ADR 0013). The host owns the actual path or URL the
// frontend selected; the guest streams it a chunk at a time. One source per instance: `open` readies
// it, then `read` returns up to `len` bytes until an empty list signals end of input.
interface import-source {
    use types.{capability-error};

    open: func() -> result<_, capability-error>;
    read: func(len: u32) -> result<list<u8>, capability-error>;
}

// A host-resolved byte sink for a bulk export (ADR 0013). The guest proposes a file name; the host
// decides the real destination (a frontend-chosen path, or a default directory). One sink per
// instance: `open` resolves and creates it, `write` appends chunks, `finish` flushes.
interface export-sink {
    use types.{capability-error};

    open: func(suggested-name: string) -> result<_, capability-error>;
    write: func(bytes: list<u8>) -> result<_, capability-error>;
    finish: func() -> result<_, capability-error>;
}

// Host-side world that aggregates every capability interface. The host generates its bindings once
// from this world (the single `Host` trait set + linker wiring); each plugin role world reuses those
// interfaces via `with` (ADR 0011 §1). A guest plugin-support crate (`genealogy-plugin-api`) also
// generates its callable import bindings from this world.
world host-imports {
    import log;
    import query;
    import commands;
    import progress;
    import import-source;
    import export-sink;
}

// A bulk import plugin: reads the document from the host-opened `import-source`, drives `commands`,
// reports `progress`, and returns the number of records imported. Format-neutral — GEDCOM, Gramps
// XML, and future formats all use this world (ADR 0013).
world bulk-import {
    import log;
    import commands;
    import progress;
    import import-source;

    export run-import: func() -> result<u32, string>;
}

// A bulk export plugin: reads via `query`, writes the serialized document to the host-resolved
// `export-sink`, reports `progress`, and returns the number of records written.
world bulk-export {
    import log;
    import query;
    import progress;
    import export-sink;

    export run-export: func() -> result<u32, string>;
}

// A plugin that contributes UI (ADR 0012): it returns a form description as a JSON string matching
// the `genealogy-ui` vocabulary schema. The host carries the payload opaquely (it does not parse or
// render it); the framework renderer parses and interprets it. Imports only `log`.
world ui-panel {
    import log;

    // Returns the form as a JSON string whose labels are Fluent message IDs; the frontend resolves
    // them against the plugin's own catalogue (ADR 0012 §5). Locale-independent, so no locale param.
    export run-ui-panel: func() -> result<string, string>;
}

// A test-only world for exercising host mechanics (capability gating, fuel, memory) without GEDCOM.
world fixture {
    import log;
    import commands;

    // Create one person; returns its human id. Used to prove a granted/denied `commands` call.
    export try-create: func() -> result<string, string>;
    // Loop forever — used to prove the fuel limit traps a runaway guest.
    export busy-loop: func();
    // Allocate roughly `mib` MiB of linear memory — used to prove the memory cap.
    export allocate: func(mib: u32) -> u32;
}

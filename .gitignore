# Rust build output
/target

# Generated by vitni-cli/build.rs from per-aggregate .ftl files (compile-time domain file)
crates/vitni-cli/i18n/*/vitni-cli.ftl

# WASM plugin components are workspace-excluded crates (ADR 0011 §6), so each builds into its own
# target/ dir rather than the workspace /target. Ignore those; keep the crate sources and lockfiles.
plugins/*/target/

# Runtime workspace artifacts (a data workspace may live alongside the source
# during local testing). The durable store is data/normalized/*.json, committed
# from within a workspace — never from the source repo.
vitni.db
vitni.db-shm
vitni.db-wal
/backups/
/exports/
/data/raw/

# Design-discussion notes — kept locally, never committed.
ChatGPT.md

# API keys named by [map]'s api-key-env / [ai]'s api_key_env are read from the environment; a local
# .env holding them must never be committed (#296).
.env
.env.*


# VS Code. Editor state is per-developer: `settings.json` (colour customizations) and `mcp.json`
# (absolute paths to a local MCP server) are machine-local, so nothing here is committed except
# launch/task/extension definitions, which are project content.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Agent configuration. Machine-local for the same reason: hooks and MCP server entries carry absolute
# paths to this checkout, and the skills are wrappers around a local MCP server rather than project
# content. Agent instructions that *are* project content live in the committed CLAUDE.md.
.claire/
.claude/worktrees/
.claude/settings.json
.claude/skills/
.mcp.json
*.rlib
# Added by code-review-graph
.code-review-graph/

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.idea/
